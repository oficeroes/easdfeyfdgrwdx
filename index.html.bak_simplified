<script>
/* ===========================================================
   多视图切换 + 上一章/下一章 闭环
   =========================================================== */
(function () {
  const order = ['home', 'background', 'analysis', 'findings', 'outlook'];

  function go(targetId) {
    const sections = document.querySelectorAll('.section');
    sections.forEach(s => s.classList.toggle('active', s.id === targetId));

    // 顶部导航高亮
    document.querySelectorAll('.navlinks button').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.target === targetId);
    });

    // 标题更新（浏览器 tab 显示当前章节）
    const sec = document.getElementById(targetId);
    if (sec && sec.dataset.title) {
      document.title = '澳门生态昼夜曲 · ' + sec.dataset.title;
    }

    // 滚动到顶部（导航高度补偿）
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // 1) 顶部导航按钮
  document.querySelectorAll('.navlinks button').forEach(btn => {
    btn.addEventListener('click', () => go(btn.dataset.target));
  });

  // 2) 上一章 / 下一章 按钮（每个 section 内部各自的 .pager）
  document.querySelectorAll('.pager button[data-action]').forEach(btn => {
    btn.addEventListener('click', () => {
      const currentSec = btn.closest('.section');
      const idx = order.indexOf(currentSec.id);
      let nextIdx;
      if (btn.dataset.action === 'next') {
        nextIdx = (idx + 1) % order.length;            // 形成闭环
      } else {
        nextIdx = (idx - 1 + order.length) % order.length;
      }
      go(order[nextIdx]);
    });
  });

  // 3) "回到主页 ↺" 锚链接
  document.querySelectorAll('a[data-target]').forEach(a => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      go(a.dataset.target);
    });
  });

  // 4) 键盘左右方向键翻页
  document.addEventListener('keydown', (e) => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    const modal = document.getElementById('mapModal');
    if (modal && modal.classList.contains('open')) return;  // 模态打开时禁用翻页
    const currentActive = document.querySelector('.section.active');
    if (!currentActive) return;
    const idx = order.indexOf(currentActive.id);
    if (e.key === 'ArrowRight') go(order[(idx + 1) % order.length]);
    if (e.key === 'ArrowLeft')  go(order[(idx - 1 + order.length) % order.length]);
  });
})();

/* ===========================================================
   交互式热点图模态
   - 点击图片或"打开交互式热点图"按钮 → 加载 iframe
   - 关闭按钮 / ESC / 点遮罩 → 关闭并卸载 iframe（释放内存）
   =========================================================== */
(function () {
  const modal     = document.getElementById('mapModal');
  const iframe    = document.getElementById('mapModalIframe');
  const closeBtn  = document.getElementById('mapModalClose');
  const HOTSPOT_URL = '热点图展示/澳门生物多样性热点图.html';

  function openMap() {
    iframe.src = HOTSPOT_URL;
    modal.classList.add('open');
    document.body.classList.add('modal-open');
  }
  function closeMap() {
    modal.classList.remove('open');
    document.body.classList.remove('modal-open');
    // 卸载 iframe，节省内存并停止地图脚本运行
    setTimeout(() => { iframe.src = ''; }, 250);
  }

  // 按钮触发
  document.querySelectorAll('[data-open="hotspot"]').forEach(btn => {
    btn.addEventListener('click', openMap);
  });
  // 点击图片也能打开
  document.querySelectorAll('.hotspot-figure img').forEach(img => {
    img.addEventListener('click', openMap);
  });

  // 关闭交互
  closeBtn.addEventListener('click', closeMap);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeMap();  // 点遮罩区域关闭
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal.classList.contains('open')) closeMap();
  });
})();
</script>

